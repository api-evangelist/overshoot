          "request": {
            "name": "Renew stream lease",
            "description": {
              "content": "Renews the stream lease and returns a fresh publish token. Clients should renew\nbefore the 5-minute lease expires, for example every 4 minutes, and pass the\nreturned token to the LiveKit SDK with `room.updateToken(...)`.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "streams",
                ":stream_id",
                "keepalive"
